CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_h3c_nx30-pro=y

# 核心插件选择
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Xray=y
CONFIG_PACKAGE_xray-core=y

# 常用协议支持（按需包含）
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Libev_Full=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Trojan_Plus=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_SingBox=y

# 语言包
CONFIG_LUCI_LANG_zh_Hans=y
